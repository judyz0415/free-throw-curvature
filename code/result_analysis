import json
import pandas as pd
import numpy as np
import statsmodels.api as sm
import matplotlib.pyplot as plt
import seaborn as sns
from scipy.integrate import simpson

plt.rcParams.update({
    'font.family': 'serif',
    'axes.spines.top': False,
    'axes.spines.right': False,
    'axes.linewidth': 0.8,
    'xtick.major.width': 0.8,
    'ytick.major.width': 0.8,
})

file_path = 'curvature_results.xlsx'
df = pd.read_excel(file_path)

# ── load optimal parameters from nonlinear solver ──────────────────────────────
try:
    with open('optimal_params.json') as f:
        _params = json.load(f)
    ELL_OPT  = _params['ell']
    R2_OOS   = _params['r2_oos']
    print(f"Loaded optimal_params.json: ell={ELL_OPT:.4f}, R²_OOS={R2_OOS:.4f}")
except FileNotFoundError:
    ELL_OPT = 6.0   # fallback if select_l_parameter.py has not been run yet
    R2_OOS  = None
    print("optimal_params.json not found — falling back to ell=6.0")

# compute sigma_ell for the optimal ell directly from kappa arrays
try:
    _T = np.linspace(0, 1, 100)
    _kappas = np.load('kappa_arrays.npy')   # (n_players, 100)
    _w = (ELL_OPT + 1) * _T ** ELL_OPT
    df['sigma_ell_opt'] = [float(simpson(_w * k, _T)) for k in _kappas]
    _col4   = 'sigma_ell_opt'
    _label4 = fr'Time-weighted Curvature Integral ($\ell={ELL_OPT:.2f}$)'
except FileNotFoundError:
    _col4   = f'sigma_l_{ELL_OPT:.1f}'
    _label4 = fr'Time-weighted Curvature Integral ($\ell={ELL_OPT:g}$)'
    print("kappa_arrays.npy not found — using pre-computed sigma_l column")

# ── metric labels ──────────────────────────────────────────────────────────────
metrics = [
    ('Max Curvature', 'Max Curvature'),
    ('sigma_l_0.0',   r'Unweighted Curvature Integral ($\ell=0$)'),
    ('sigma_l_3.0',   r'Time-weighted Curvature Integral ($\ell=3$)'),
    (_col4,           _label4),
]

# ── histograms ─────────────────────────────────────────────────────────────────
fig, axes_hist = plt.subplots(2, 2, figsize=(12, 8))
axes_hist = axes_hist.flatten()
for idx, (col, label) in enumerate(metrics):
    sns.histplot(df[col], kde=True, bins=15, ax=axes_hist[idx],
                 color='#2c7bb6', edgecolor='white', linewidth=0.4)
    axes_hist[idx].set_title(f'Distribution of {label}', fontsize=13)
    axes_hist[idx].set_xlabel(label, fontsize=12)
    axes_hist[idx].set_ylabel('Frequency', fontsize=12)
    axes_hist[idx].tick_params(labelsize=10)
plt.tight_layout(pad=1.5)
plt.savefig('distributions.png', dpi=300, bbox_inches='tight')
plt.show()

# ── WLS regression ─────────────────────────────────────────────────────────────
y       = df['FT%']
weights = 1 / (df['FT% SE'] ** 2)

summary_data = []
for col, label in metrics:
    X      = sm.add_constant(df[col])
    model  = sm.WLS(y, X, weights=weights)
    result = model.fit()
    row = {
        'Metric':       label,
        'Coefficient':  result.params.iloc[1],
        'P-Value':      result.pvalues.iloc[1],
        'R²':           result.rsquared,
        'Adj. R²':      result.rsquared_adj,
    }
    # attach out-of-sample R² only for the optimal-ell model
    if col == _col4 and R2_OOS is not None:
        row['OOS R² (LOOCV)'] = R2_OOS
    summary_data.append(row)

summary_table = pd.DataFrame(summary_data).round(4)
print(summary_table.to_string(index=False))

# ── regression plots ───────────────────────────────────────────────────────────
fig, axes = plt.subplots(2, 2, figsize=(12, 10))
axes = axes.flatten()

for i, (col, label) in enumerate(metrics):
    X      = sm.add_constant(df[col])
    model  = sm.WLS(y, X, weights=weights)
    result = model.fit()

    x_vals = np.linspace(df[col].min(), df[col].max(), 100)
    X_pred = sm.add_constant(x_vals)
    y_pred = result.predict(X_pred)

    cov    = result.cov_params()
    se_pred = np.sqrt(
        cov.loc['const', 'const'] +
        x_vals**2 * cov.loc[col, col] +
        2 * x_vals * cov.loc['const', col]
    )
    ci = 1.96 * se_pred

    axes[i].scatter(df[col], y, alpha=0.7, color='#2c7bb6', s=35, zorder=3)
    axes[i].plot(x_vals, y_pred, color='black', linewidth=1.5, label='WLS fit')
    axes[i].fill_between(x_vals, y_pred - ci, y_pred + ci,
                         color='#d7191c', alpha=0.15, label='95% CI')
    axes[i].set_xlabel(label, fontsize=12)
    axes[i].set_ylabel('FT%', fontsize=12)
    axes[i].tick_params(labelsize=10)
    axes[i].legend(fontsize=10, frameon=False)

plt.tight_layout(pad=1.5)
plt.savefig('regressionlines.png', dpi=300, bbox_inches='tight')
plt.show()
